{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "router-config.yaml",
  "type": "object",
  "required": [
    "providers",
    "models",
    "routing",
    "complexity",
    "escalation"
  ],
  "properties": {
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "api_key_env",
          "rate_limit",
          "timeout_seconds",
          "retry"
        ],
        "properties": {
          "api_key_env": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "display_label": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "api_version": {
            "type": "string"
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rate_limit": {
            "type": "object",
            "required": [
              "requests_per_minute",
              "tokens_per_minute"
            ],
            "properties": {
              "requests_per_minute": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "tokens_per_minute": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            }
          },
          "retry": {
            "type": "object",
            "required": [
              "max_retries",
              "backoff_base_seconds"
            ],
            "properties": {
              "max_retries": {
                "type": "integer",
                "minimum": 0
              },
              "backoff_base_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "provider"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "integer",
            "minimum": 1
          },
          "is_enabled": {
            "type": "boolean"
          },
          "is_enabled_as_verifier": {
            "type": "boolean"
          },
          "input_cost_per_1m": {
            "type": "number",
            "minimum": 0
          },
          "output_cost_per_1m": {
            "type": "number",
            "minimum": 0
          },
          "max_context_tokens": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "max_output_tokens": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "system_prompt_file": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "confirmed_on": {
            "type": "string",
            "format": "date"
          },
          "generation_params": {
            "type": "object"
          },
          "pricing": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "input_cost_per_1m",
                "output_cost_per_1m"
              ],
              "additionalProperties": false,
              "properties": {
                "input_cost_per_1m": {
                  "type": "number",
                  "minimum": 0
                },
                "output_cost_per_1m": {
                  "type": "number",
                  "minimum": 0
                },
                "max_input_tokens": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "effective_from": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              }
            }
          }
        },
        "dependentRequired": {
          "input_cost_per_1m": [
            "output_cost_per_1m"
          ],
          "output_cost_per_1m": [
            "input_cost_per_1m"
          ]
        },
        "not": {
          "allOf": [
            {
              "required": [
                "pricing"
              ]
            },
            {
              "anyOf": [
                {
                  "required": [
                    "input_cost_per_1m"
                  ]
                },
                {
                  "required": [
                    "output_cost_per_1m"
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "routing": {
      "type": "object",
      "required": [
        "tier1_max_complexity",
        "tier2_max_complexity",
        "tier_assignments"
      ],
      "properties": {
        "tier1_max_complexity": {
          "type": "integer"
        },
        "tier2_max_complexity": {
          "type": "integer"
        },
        "default_tier": {
          "type": "integer"
        },
        "tier_assignments": {
          "type": "object"
        },
        "task_type_overrides": {
          "type": "object"
        }
      }
    },
    "complexity": {
      "type": "object",
      "required": [
        "weights",
        "context_length_scores",
        "task_type_scores",
        "high_complexity_keywords",
        "low_complexity_keywords"
      ]
    },
    "escalation": {
      "type": "object",
      "required": [
        "enabled",
        "max_escalations",
        "triggers"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_escalations": {
          "type": "integer",
          "minimum": 0
        },
        "triggers": {
          "type": "object"
        },
        "refusal_phrases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "properties": {
        "profile": {
          "enum": [
            "api",
            "copilot-cli",
            "offline"
          ]
        }
      }
    },
    "transports": {
      "type": "object",
      "properties": {
        "offline": {
          "type": "object",
          "properties": {
            "responses_dir": {
              "type": "string",
              "minLength": 1,
              "description": "Directory of scripted verifier responses, consumed in lexical order. Overridden by DABBLER_OFFLINE_RESPONSES."
            }
          }
        },
        "copilot-cli": {
          "type": "object",
          "properties": {
            "binary": {
              "type": "string",
              "minLength": 1
            },
            "lockfile": {
              "type": "string",
              "minLength": 1
            },
            "billed_usage_unavailable": {
              "type": "boolean"
            },
            "max_invocations_per_session": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "timeouts": {
              "type": "object",
              "properties": {
                "spawn_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "first_byte_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "total_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "roles": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "prefer": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "require_provider_in": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "task_type_params": {
      "type": "object"
    },
    "testing": {
      "type": "object"
    },
    "verification": {
      "type": "object"
    },
    "critique": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pipeline": {
          "enum": [
            "off",
            "shadow",
            "enforce"
          ],
          "description": "The critique pipeline's authority. 'off' is the default and writes nothing. 'shadow' records critique artifacts without letting them decide anything. 'enforce' is declared here so the vocabulary lives in one place, and is refused at load until the set that implements it lands — see config.py, which names that set in the refusal."
        }
      }
    },
    "metrics": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "run_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "fast",
            "verified"
          ]
        },
        "verification_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "diff_limit_lines": {
          "type": "integer",
          "minimum": 1
        },
        "check_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model_usd": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "model_dispatches": {
              "type": "integer",
              "minimum": 1
            },
            "elapsed_minutes": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            }
          }
        },
        "sensitive_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "push_on_finish": {
          "type": "boolean"
        },
        "worktree_per_run": {
          "type": "boolean"
        },
        "remote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "explorer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stale_after_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": [
            "string",
            "null"
          ]
        },
        "init": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "argv": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "windows",
                      "posix"
                    ],
                    "properties": {
                      "windows": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      },
                      "posix": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                ]
              },
              "probe_argv": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "windows",
                      "posix"
                    ],
                    "properties": {
                      "windows": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      },
                      "posix": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                ]
              },
              "shell": {
                "type": "boolean"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "timeout_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  }
}
