{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rounds.jsonl row (one verification round)",
  "description": "One row per completed verification round in .dabbler/runs/<set>/s<N>/rounds.jsonl. Written only by the CLI (ai_router.verify); the close gate reads it. A row that fails this schema on read is a refusal, never a skip. Two terminal row types may be written beside plain rounds: 'adjudication' (a third provider judged the recorded disputes) and 'remediated_at_cap' (every blocking finding of the last round was fixed and the cap left the fix unreviewed — the work lands labelled unreviewed, which is not a waiver: nothing was accepted over a standing finding). The retired 'waive' type stays readable because historical ledgers carry it; no writer emits it, and WAIVED is no longer in the writer's verdict vocabulary.",
  "type": "object",
  "required": [
    "round",
    "verdict",
    "blocking",
    "findings",
    "completion_tree",
    "recorded_at"
  ],
  "properties": {
    "round": { "type": "integer", "minimum": 1 },
    "phase": { "type": "string", "enum": ["full", "fix-delta"] },
    "verdict": {
      "type": "string",
      "enum": ["VERIFIED", "ISSUES_FOUND", "WAIVED", "REMEDIATED_AT_CAP"]
    },
    "blocking": { "type": "boolean" },
    "verifier_model": { "type": "string", "minLength": 1 },
    "verifier_provider": { "type": "string", "minLength": 1 },
    "orchestrator_provider": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "severity"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["critical", "major", "minor"]
          },
          "category": { "type": "string" },
          "failureScenario": { "type": "string" },
          "evidencePaths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "cost_usd": {
      "type": ["number", "null"],
      "description": "Historical only. Dollars are not computed anywhere in this framework -- tokens are the record and the vendor's console is the reconciliation -- so no writer emits this key; it stays readable because older ledgers carry it."
    },
    "baseline_tree": { "type": ["string", "null"] },
    "completion_tree": { "type": "string", "minLength": 7 },
    "previous_tree": { "type": "string", "minLength": 7 },
    "recorded_at": { "type": "string", "minLength": 1 },
    "transport": { "type": "string" },
    "agency": {
      "description": "The verifier's tool surface for this round: what it was granted, and what it did with it. mode 'none' is a round that could not look at the tree at all (the direct-API path sends no tools) and is never equivalent to one that could. in_scope means the operation was confined to the grant: a read names a path and is placed against the scope, while a search or listing is confined only when it also names a path — a pattern on its own reaches the whole tree and is recorded as unconfined. Each read carries a fidelity: 'verbatim' means the shown lines matched the bytes on disk, 'transformed' means they did not (the credential scrubber rewrites text before a model sees it, and a finding resting on a transformed read is weighable rather than trustable), 'unverified' means the comparison could not be made. 'writes' is the fourth operation and the only one no tool performs: the verifier proposes a test file in its answer and the framework writes the bytes, so a proposal outside the declared test root is refused before anything reaches the filesystem. Every proposal is recorded, applied or refused, because a boundary nobody can see being enforced is indistinguishable from one that is not there.",
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["tools", "none"] },
        "operations_granted": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["list", "search", "read", "write"]
          }
        },
        "read_budget": { "type": "integer", "minimum": 0 },
        "scope": { "type": "array", "items": { "type": "string" } },
        "scope_size": { "type": "integer", "minimum": 0 },
        "reads": { "type": "integer", "minimum": 0 },
        "listings": { "type": "integer", "minimum": 0 },
        "searches": { "type": "integer", "minimum": 0 },
        "out_of_scope": { "type": "integer", "minimum": 0 },
        "over_budget": { "type": "integer", "minimum": 0 },
        "transformed_reads": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "target", "in_scope"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["list", "search", "read"]
              },
              "target": { "type": "string" },
              "in_scope": { "type": "boolean" },
              "fidelity": {
                "type": "string",
                "enum": ["verbatim", "transformed", "unverified"]
              },
              "detail": { "type": "string" }
            }
          }
        },
        "writes_applied": { "type": "integer", "minimum": 0 },
        "writes_refused": { "type": "integer", "minimum": 0 },
        "writes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "outcome"],
            "properties": {
              "path": { "type": "string" },
              "outcome": {
                "type": "string",
                "enum": ["accepted", "refused"]
              },
              "action": {
                "type": "string",
                "enum": ["created", "modified"]
              },
              "bytes": { "type": "integer", "minimum": 0 },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "type": {
      "type": "string",
      "enum": ["adjudication", "waive", "remediated_at_cap"]
    },
    "excluded_providers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["finding_index", "outcome"],
        "properties": {
          "finding_index": { "type": "integer", "minimum": 0 },
          "outcome": { "type": "string", "enum": ["UPHELD", "OVERRULED"] },
          "reasons": { "type": "string" }
        }
      }
    },
    "attestation": { "type": "string", "minLength": 1 },
    "remediated": {
      "type": "object",
      "required": ["reviewed_round", "findings"],
      "properties": {
        "reviewed_round": { "type": "integer", "minimum": 1 },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["description", "severity"]
          }
        }
      }
    },
    "waived": {
      "type": "object",
      "required": ["exhausted_via", "findings"],
      "properties": {
        "exhausted_via": {
          "type": "string",
          "enum": ["upheld-adjudication", "adjudication-unavailable"]
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["description", "severity"]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "round": { "minimum": 2 } } },
      "then": { "required": ["previous_tree"] }
    },
    {
      "if": {
        "properties": { "type": { "const": "adjudication" } },
        "required": ["type"]
      },
      "then": { "required": ["outcomes", "excluded_providers"] }
    },
    {
      "if": {
        "properties": { "type": { "const": "waive" } },
        "required": ["type"]
      },
      "then": {
        "required": ["attestation", "waived"],
        "properties": {
          "verdict": { "const": "WAIVED" },
          "blocking": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "remediated_at_cap" } },
        "required": ["type"]
      },
      "then": {
        "required": ["remediated", "previous_tree"],
        "properties": {
          "verdict": { "const": "REMEDIATED_AT_CAP" },
          "blocking": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": { "enum": ["waive", "remediated_at_cap"] }
        },
        "required": ["type"]
      },
      "then": true,
      "else": {
        "required": ["verifier_model", "verifier_provider"],
        "properties": {
          "verdict": { "enum": ["VERIFIED", "ISSUES_FOUND"] }
        }
      }
    }
  ]
}
