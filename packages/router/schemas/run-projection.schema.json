{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-projection.schema.json",
  "title": "run-projection.json (.dabbler/run-projection.json)",
  "type": "object",
  "required": [
    "schema_version", "projection_revision", "organization_digest",
    "generated_at", "sessions", "runs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "projection_revision": { "type": "integer", "minimum": 0 },
    "organization_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_at": { "type": ["string", "null"] },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["detail"],
        "additionalProperties": false,
        "properties": {
          "detail": { "type": "string" }
        }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "title", "policy", "state", "run_ids"],
        "additionalProperties": false,
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "policy": { "enum": ["fast", "verified"] },
          "state": {
            "enum": ["not-started", "in-progress", "complete", "cancelled"]
          },
          "run_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "current_run_id": { "type": ["string", "null"] },
          "needs_attention": { "type": "boolean" }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": [
        "run_id", "policy", "state", "waiting_reason", "ask",
        "session_number", "engine", "provider", "branch", "started_at",
        "last_activity_at", "pending_guidance", "attempt", "tasks", "checks",
        "verification", "cost", "commit", "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "policy": { "enum": ["fast", "verified"] },
        "state": {
          "enum": [
            "created", "running", "waiting", "verifying", "remediating",
            "completed", "failed", "cancelled"
          ]
        },
        "waiting_reason": { "enum": ["operator", "dependency", null] },
        "waiting_sequence": { "type": ["integer", "null"] },
        "ask": { "type": "string" },
        "session_number": { "type": "integer", "minimum": 1 },
        "engine": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "worktree_id": { "type": ["string", "null"] },
        "base_commit": { "type": ["string", "null"] },
        "started_at": { "type": ["string", "null"] },
        "last_activity_at": { "type": ["string", "null"] },
        "pending_guidance": { "type": "integer", "minimum": 0 },
        "attempt": { "type": "integer", "minimum": 1 },
        "escalations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id", "label", "state", "started_at", "last_activity_at"
            ],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "state": {
                "enum": [
                  "pending", "in-progress", "waiting", "complete", "failed"
                ]
              },
              "started_at": { "type": ["string", "null"] },
              "last_activity_at": { "type": ["string", "null"] }
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["check_id", "stage", "outcome", "duration_seconds"],
            "additionalProperties": false,
            "properties": {
              "check_id": { "type": "string", "minLength": 1 },
              "stage": { "enum": ["targeted", "final-full"] },
              "outcome": { "enum": ["passed", "failed"] },
              "duration_seconds": { "type": "number", "minimum": 0 },
              "tree_digest": { "type": "string" },
              "tree_mutated": { "type": "boolean" },
              "required": { "type": "boolean" }
            }
          }
        },
        "verification": {
          "type": "object",
          "required": [
            "rounds", "last_verdict", "verifier_provider", "transport"
          ],
          "additionalProperties": false,
          "properties": {
            "rounds": { "type": "integer", "minimum": 0 },
            "last_verdict": {
              "enum": ["VERIFIED", "ISSUES_FOUND", "WAIVED", "REMEDIATED_AT_CAP", null]
            },
            "verifier_provider": { "type": ["string", "null"] },
            "transport": { "type": ["string", "null"] },
            "accepted_tree_digest": { "type": ["string", "null"] },
            "blocking_findings": { "type": "integer", "minimum": 0 },
            "minor_findings": { "type": "integer", "minimum": 0 },
            "round_limit": { "type": "integer", "minimum": 1 },
            "dispatch_limit": { "type": "integer", "minimum": 1 }
          }
        },
        "cost": {
          "type": "object",
          "required": ["model_usd", "unpriced_calls"],
          "additionalProperties": false,
          "properties": {
            "model_usd": { "type": "number", "minimum": 0 },
            "unpriced_calls": { "type": "integer", "minimum": 0 },
            "dispatches": { "type": "integer", "minimum": 0 }
          }
        },
        "commit": { "type": ["string", "null"] },
        "outcome": { "enum": ["completed", "failed", "cancelled", null] },
        "verdict": { "enum": ["VERIFIED", "ISSUES_FOUND", "WAIVED", "REMEDIATED_AT_CAP", null] },
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sequence", "note", "occurred_at"],
            "additionalProperties": false,
            "properties": {
              "sequence": { "type": "integer", "minimum": 1 },
              "note": { "type": "string" },
              "occurred_at": { "type": "string" },
              "uncertain": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
