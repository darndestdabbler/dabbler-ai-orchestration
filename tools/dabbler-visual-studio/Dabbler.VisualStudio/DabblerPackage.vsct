  <Commands package="guidDabblerPackage">
    <Groups>
      <Group guid="guidDabblerCommandSet" id="DabblerToolsGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidDabblerCommandSet" id="VersionCommandId" priority="0x0100" type="Button">
        <Parent guid="guidDabblerCommandSet" id="DabblerToolsGroup" />
        <Strings>
          <ButtonText>Dabbler: Version</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidDabblerCommandSet" id="OpenEngineHereCommandId" priority="0x0101" type="Button">
        <Parent guid="guidDabblerCommandSet" id="DabblerToolsGroup" />
        <Strings>
          <ButtonText>Dabbler: Open Engine Here</ButtonText>
          <CanonicalName>.Dabbler.OpenEngineHere</CanonicalName>
          <LocCanonicalName>.Dabbler.OpenEngineHere</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDabblerCommandSet" id="WorkExplorerCommandId" priority="0x0100" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Strings>
          <ButtonText>Dabbler Work Explorer</ButtonText>
          <CanonicalName>.Dabbler.WorkExplorer</CanonicalName>
          <LocCanonicalName>.Dabbler.WorkExplorer</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDabblerCommandSet" id="TerminalCommandId" priority="0x0101" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Strings>
          <ButtonText>Dabbler Terminal</ButtonText>
          <CanonicalName>.Dabbler.Terminal</CanonicalName>
          <LocCanonicalName>.Dabbler.Terminal</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidDabblerCommandSet" id="ConfigurationCommandId" priority="0x0102" type="Button">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
        <Strings>
          <ButtonText>Dabbler Configuration</ButtonText>
          <CanonicalName>.Dabbler.Configuration</CanonicalName>
          <LocCanonicalName>.Dabbler.Configuration</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidDabblerPackage" value="{425b072f-e523-4795-9b61-5716674585bd}" />
    <GuidSymbol name="guidDabblerCommandSet" value="{a9db3fec-b5ee-439b-acfe-21f711d1ec33}">
