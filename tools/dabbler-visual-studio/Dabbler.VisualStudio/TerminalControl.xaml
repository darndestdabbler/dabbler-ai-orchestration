<UserControl x:Class="Dabbler.VisualStudio.TerminalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:Dabbler.VisualStudio"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">
  <!-- No horizontal scrolling, so a row is as wide as the window and a long one wraps. -->
  <ListBox x:Name="List"
           ItemsSource="{Binding Rows}"
           Background="Transparent"
           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
           BorderThickness="0"
           SelectionMode="Extended"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
           ScrollViewer.ScrollChanged="OnScrollChanged"
           Grid.IsSharedSizeScope="True">
    <ListBox.CommandBindings>
      <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopy" CanExecute="OnCanCopy" />
    </ListBox.CommandBindings>
    <ListBox.ContextMenu>
      <ContextMenu>
        <MenuItem Command="ApplicationCommands.Copy" Header="Copy" />
      </ContextMenu>
    </ListBox.ContextMenu>
    <ListBox.ItemContainerStyle>
      <Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
      </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
      <DataTemplate>
        <!-- The clock's column is as wide as the widest clock, so every event starts at one place and a line wraps under it. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="Clock" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Margin="0,0,6,0" local:TerminalControl.Piece="{Binding Clock}" />
          <TextBlock x:Name="Pieces" Grid.Column="1" TextWrapping="Wrap" local:TerminalControl.Pieces="{Binding Pieces}" />
        </Grid>
        <DataTemplate.Triggers>
          <!-- A heading has no clock, and takes the whole row. -->
          <DataTrigger Binding="{Binding IsHeading}" Value="True">
            <Setter TargetName="Pieces" Property="Grid.Column" Value="0" />
            <Setter TargetName="Pieces" Property="Grid.ColumnSpan" Value="2" />
            <Setter TargetName="Pieces" Property="Margin" Value="0,4,0,0" />
          </DataTrigger>
          <!-- A job's output has no clock either, and is shown in a fixed-width face, as it came. -->
          <DataTrigger Binding="{Binding IsJobOutput}" Value="True">
            <Setter TargetName="Pieces" Property="Grid.Column" Value="0" />
            <Setter TargetName="Pieces" Property="Grid.ColumnSpan" Value="2" />
            <Setter TargetName="Pieces" Property="FontFamily" Value="Consolas" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
