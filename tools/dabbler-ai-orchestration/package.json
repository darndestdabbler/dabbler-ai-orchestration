        "title": "Copy Start the next session",
        "category": "Dabbler"
      },
      {
        "command": "dabbler.getStarted",
        "title": "Get Started",
        "category": "Dabbler",
        "icon": "$(star)"
      },
      {
        "command": "dabbler.setupNewProject",
        "title": "Set Up New Project",
        "category": "Dabbler",
        "icon": "$(add)"
      },
      {
        "command": "dabbler.trySampleProject",
        "title": "Try a sample project",
        "category": "Dabbler",
        "icon": "$(beaker)"
      },
      {
        "command": "dabbler.newModule",
        "title": "New Module",
        "category": "Dabbler",
        "icon": "$(add)"
      },
      {
        "command": "dabbler.assignLegacySetsToModule",
        "title": "Assign Legacy Sets to Module",
        "category": "Dabbler"
      },
      {
        "command": "dabbler.renameModule",
        "title": "Rename Module",
        "category": "Dabbler"
      },
      {
        "command": "dabbler.deleteModule",
        "title": "Delete Module",
        "category": "Dabbler"
      },
      {
        "command": "dabbler.openModulePlan",
        "title": "Open Module Plan",
        "category": "Dabbler",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dabbler.openModulesManifest",
        "title": "Open modules.yaml",
        "category": "Dabbler",
        "icon": "$(list-tree)"
      },
      {
        "command": "dabbler.copyModuleDecompositionPrompt",
        "title": "Copy Module Decomposition Prompt",
        "category": "Dabbler"
      },
      {
        "command": "dabbler.troubleshoot",
        "title": "Troubleshoot",
        "category": "Dabbler",
        "icon": "$(debug)"
      },
      {
        "command": "dabblerSessionSets.cancel",
        "title": "Cancel Session Set",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.restore",
