__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
# The run ledger travels with the session (de583d11): the gates read
# .dabbler/runs -- rounds, test-run records, state-writes.jsonl -- so a
# machine picking up a session mid-flight needs them. Ignoring the
# directory outright would have made that commit a one-time snapshot,
# because a tracked file overrides .gitignore but a NEW one under an
# ignored directory is still skipped by 'git add -A'. Round 2's output
# would have gone missing exactly the way round 1's did.
.dabbler/*
!.dabbler/runs/
# Derived or machine-specific, and never shared: the projection rebuilds
# from the journal, and the API model record belongs to whichever key set
# is present on this machine.
.dabbler/run-projection.json
.dabbler/api-models.lock
router-metrics.jsonl
local-overrides.yaml
node_modules/
.vscode-test/
out/
*.vsix
test-results/

# Offline-transport queue position, not content.
**/scripted-reviews/**/.cursor
