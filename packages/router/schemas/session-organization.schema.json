{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-organization.schema.json",
  "title": "Normalized session intent parsed from docs/sessions/session-plan.md",
  "type": "object",
  "required": ["schema_version", "sessions", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "plan_path": { "type": "string", "minLength": 1 },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "title", "policy"],
        "additionalProperties": false,
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "policy": { "enum": ["fast", "verified", null] },
          "notes": { "type": "string" }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["detail"],
        "additionalProperties": false,
        "properties": {
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
