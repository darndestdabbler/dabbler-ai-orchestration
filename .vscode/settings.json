{
  // How a provider is reached from this checkout. The Copilot seat: this
  // solution is developed on a seat, and no DABBLER_*_API_KEY is required to
  // run a session or a review. A checkout that holds provider keys reaches
  // the direct API deliberately, with `--transport api`.
  "dabbler.transport": "copilot-cli",
  "dabbler.authoringModel": "claude-opus-5",
  "dabbler.reviewerTransport": "copilot-cli"
}
