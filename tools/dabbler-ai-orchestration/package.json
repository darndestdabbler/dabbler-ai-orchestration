{
  "name": "dabbler-ai-orchestration",
  "displayName": "Dabbler AI Orchestration",
  "description": "Organize AI-led development like work: modules, session sets and step-by-step session plans in a native tree \u2014 plus routed verification before every close, normally cross-provider, recorded as evidence you can check.",
  "version": "1.0.4",
  "publisher": "DarndestDabbler",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "ai",
    "ai agent",
    "agent workflow",
    "orchestration",
    "verification",
    "session sets",
    "planning",
    "dabbler"
  ],
  "icon": "media/darndest-dabbler-icon.png",
  "galleryBanner": {
    "color": "#5DADE2",
    "theme": "dark"
  },
  "homepage": "https://darndestdabbler.org",
  "bugs": {
    "url": "https://github.com/darndestdabbler/dabbler-ai-orchestration/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/darndestdabbler/dabbler-ai-orchestration.git"
  },
  "license": "MIT",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dabblerSessionSetsContainer",
          "title": "AI Work Explorer",
          "icon": "media/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "dabblerSessionSetsContainer": [
        {
          "id": "dabblerSolutionTree",
          "name": "Solution Explorer",
          "contextualTitle": "Solution Explorer"
        },
        {
          "id": "dabblerWorkExplorerTree",
          "name": "AI Work Explorer",
          "contextualTitle": "AI Work Explorer"
        }
      ]
    },
    "commands": [
      {
        "command": "dabblerSessionSets.refresh",
        "title": "Refresh Work Explorer",
        "category": "Dabbler",
        "icon": "$(refresh)"
      },
      {
        "command": "dabblerSessionSets.openSpec",
        "title": "Open Session Plan",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.openActivityLog",
        "title": "Open Activity Log",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.openChangeLog",
        "title": "Open Change Log",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.openSessionState",
        "title": "Open Sessions Ledger",
        "category": "Dabbler"
      },
      {
        "command": "dabbler.copyStartNextSessionPrompt",
        "title": "Copy Start the next session",
        "category": "Dabbler"
      },
      {
        "command": "dabbler.copySessionRunPrompt",
        "title": "Copy Run Prompt",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.startSession",
        "title": "Start Next Session (terminal)",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.closeSession",
        "title": "Close Session (terminal)",
        "category": "Dabbler"
      },
      {
        "command": "dabbler.newModule",
        "title": "New Module",
        "category": "Dabbler",
        "icon": "$(add)"
      },
      {
        "command": "dabblerSessionSets.cancel",
        "title": "Cancel Session",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.restore",
        "title": "Restore Session",
        "category": "Dabbler"
      },
      {
        "command": "dabbler.setupNewProject",
        "title": "Set Up New Project",
        "category": "Dabbler",
        "icon": "$(add)"
      },
      {
        "command": "dabblerSessionSets.installAiRouter",
        "title": "Install ai-router",
        "category": "Dabbler",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dabbler.troubleshoot",
        "title": "Troubleshoot",
        "category": "Dabbler",
        "icon": "$(debug)"
      },
      {
        "command": "dabblerWorkExplorer.activateRepository",
        "title": "Open Session Plan",
        "category": "Dabbler"
      },
      {
        "command": "dabblerWorkExplorer.activateSession",
        "title": "Open Session Plan",
        "category": "Dabbler"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dabblerWorkExplorer.activateRepository",
          "when": "false"
        },
        {
          "command": "dabblerWorkExplorer.activateSession",
          "when": "false"
        },
        {
          "command": "dabbler.copySessionRunPrompt",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "dabblerSessionSets.refresh",
          "when": "view == dabblerWorkExplorerTree",
          "group": "navigation@1"
        },
        {
          "command": "dabbler.newModule",
          "when": "view == dabblerWorkExplorerTree",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "submenu": "dabblerWorkExplorer.openFile",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;dabblerRepository;/",
          "group": "1_open@1"
        },
        {
          "submenu": "dabblerWorkExplorer.copyPrompt",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;dabblerRepository;/",
          "group": "1_open@2"
        },
        {
          "command": "dabblerSessionSets.startSession",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-startSession;/",
          "group": "6_session@601"
        },
        {
          "command": "dabblerSessionSets.closeSession",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-closeSession;/",
          "group": "6_session@602"
        },
        {
          "command": "dabblerSessionSets.cancel",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-cancel;/",
          "group": "9_lifecycle@901"
        },
        {
          "command": "dabblerSessionSets.restore",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-restore;/",
          "group": "9_lifecycle@902"
        },
        {
          "command": "dabbler.copySessionRunPrompt",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-copySessionRunPrompt;/",
          "group": "6_session@603"
        }
      ],
      "dabblerWorkExplorer.openFile": [
        {
          "command": "dabblerSessionSets.openSpec",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-openSpec;/",
          "group": "1@101"
        },
        {
          "command": "dabblerSessionSets.openActivityLog",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-openActivityLog;/",
          "group": "1@102"
        },
        {
          "command": "dabblerSessionSets.openChangeLog",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-openChangeLog;/",
          "group": "1@103"
        },
        {
          "command": "dabblerSessionSets.openSessionState",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-openSessionState;/",
          "group": "1@104"
        }
      ],
      "dabblerWorkExplorer.copyPrompt": [
        {
          "command": "dabbler.copyStartNextSessionPrompt",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-copyStartNextSessionPrompt;/",
          "group": "1@304"
        }
      ]
    },
    "configuration": {
      "title": "Dabbler AI Orchestration",
      "properties": {
        "dabblerSessionSets.pythonPath": {
          "type": "string",
          "default": "python",
          "markdownDescription": "Python executable used for every `python -m ai_router.*` invocation (tree projections, session lifecycle, module creation, install). Accepts an absolute path, a workspace-relative path (e.g. `.venv/Scripts/python.exe`), or a bare command on `PATH`. When unset, a workspace `.venv` interpreter is auto-detected."
        }
      }
    },
    "submenus": [
      {
        "id": "dabblerWorkExplorer.openFile",
        "label": "Open File"
      },
      {
        "id": "dabblerWorkExplorer.copyPrompt",
        "label": "Copy Prompt"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "npm run compile && npx tsc --outDir out && node ./out/test/runTests.js",
    "test:unit": "mocha --require ts-node/register --require ./src/test/vscode-stub.js --ui tdd --timeout 120000 'src/test/suite/**/*.test.ts'",
    "test:playwright": "npm run compile && npx tsc --outDir out && npx playwright test",
    "package": "npm run compile && npx vsce package",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.9",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "mocha": "^10.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  }
}
