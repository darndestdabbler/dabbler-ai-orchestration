{
  "name": "dabbler-ai-orchestration",
  "displayName": "Dabbler AI Orchestration",
  "description": "Work Explorer for the Dabbler AI-led workflow: session sets, modules and session plans in a native tree, plus the git and scaffolding commands the workflow runs on.",
  "version": "0.51.0",
  "publisher": "DarndestDabbler",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "AI",
    "SCM Providers"
  ],
  "keywords": [
    "ai",
    "workflow",
    "session",
    "claude",
    "orchestration",
    "dabbler",
    "adoption",
    "bootstrap",
    "onboarding"
  ],
  "icon": "media/darndest-dabbler-icon.png",
  "galleryBanner": {
    "color": "#5DADE2",
    "theme": "dark"
  },
  "homepage": "https://darndestdabbler.org",
  "bugs": {
    "url": "https://github.com/darndestdabbler/dabbler-ai-orchestration/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/darndestdabbler/dabbler-ai-orchestration.git"
  },
  "license": "MIT",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dabblerSessionSetsContainer",
          "title": "AI Orch",
          "icon": "media/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "dabblerSessionSetsContainer": [
        {
          "id": "dabblerWorkExplorerTree",
          "name": "Work Explorer",
          "contextualTitle": "AI Orch"
        }
      ]
    },
    "commands": [
      {
