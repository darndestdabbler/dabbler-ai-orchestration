{
  "name": "dabbler-ai-orchestration",
  "displayName": "Dabbler AI Orchestration",
  "description": "Organize AI-led development like work: solutions, numbered sessions and step-by-step plans in a native tree — plus cross-provider verification before every close, recorded as evidence you can check.",
  "version": "3.19.0",
  "publisher": "DarndestDabbler",
  "private": true,
  "engines": {
    "vscode": "^1.135.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "ai",
    "ai agent",
    "agent workflow",
    "orchestration",
    "verification",
    "modules",
    "planning",
    "dabbler"
  ],
  "icon": "media/darndest-dabbler-icon.png",
  "galleryBanner": {
    "color": "#5DADE2",
    "theme": "dark"
  },
  "homepage": "https://darndestdabbler.org",
  "bugs": {
    "url": "https://github.com/darndestdabbler/dabbler-ai-orchestration/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/darndestdabbler/dabbler-ai-orchestration.git"
  },
  "license": "MIT",
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dabblerSessionSetsContainer",
          "title": "Dabbler AI Orchestration",
          "icon": "media/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "dabblerSessionSetsContainer": [
        {
          "id": "dabblerSolutionTree",
          "name": "Solution Explorer",
          "contextualTitle": "Solution Explorer"
        },
        {
          "id": "dabblerWorkExplorerTree",
          "name": "Work Explorer",
          "contextualTitle": "Work Explorer"
        }
      ]
    },
    "commands": [
      {
        "command": "dabblerSessionSets.refresh",
        "title": "Refresh Work Explorer",
        "category": "Dabbler",
        "icon": "$(refresh)"
      },
      {
        "command": "dabblerSessionSets.openSpec",
        "title": "Open Session Plan",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.openActivityLog",
        "title": "Open Activity Log",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.openChangeLog",
        "title": "Open Change Log",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.openSessionState",
        "title": "Open Sessions Ledger",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.startSession",
        "title": "Start Session",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.startSessionWithDifferentModels",
        "title": "Start Session with Different Models...",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.stopSession",
        "title": "Stop Session",
        "category": "Dabbler"
      },
      {
        "command": "dabbler.consultWithAi",
        "title": "Consult with AI",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.closeSession",
        "title": "Close Session",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.cancel",
        "title": "Cancel Session",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSessionSets.restore",
        "title": "Restore Session",
        "category": "Dabbler"
      },
      {
        "command": "dabbler.setupNewProject",
        "title": "Set Up New Project",
        "category": "Dabbler",
        "icon": "$(add)"
      },
      {
        "command": "dabbler.troubleshoot",
        "title": "Troubleshoot",
        "category": "Dabbler",
        "icon": "$(debug)"
      },
      {
        "command": "dabblerWorkExplorer.activateRepository",
        "title": "Open Session Plan",
        "category": "Dabbler"
      },
      {
        "command": "dabblerWorkExplorer.activateSession",
        "title": "Open Session Plan",
        "category": "Dabbler"
      },
      {
        "command": "dabblerSolution.openRepository",
        "title": "Open Repository",
        "category": "Dabbler",
        "icon": "$(folder-opened)"
      },
      {
        "command": "dabblerSolution.openRepositoryInNewWindow",
        "title": "Open in New Window",
        "category": "Dabbler",
        "icon": "$(empty-window)"
      },
      {
        "command": "dabblerSolution.setEngine",
        "title": "Set the Authoring Vehicle",
        "category": "Dabbler",
        "icon": "$(edit)"
      },
      {
        "command": "dabblerSolution.setReviewerTransport",
        "title": "Set the Reviewing Vehicle",
        "category": "Dabbler",
        "icon": "$(edit)"
      },
      {
        "command": "dabblerSolution.setAuthoringModel",
        "title": "Set the Authoring Model",
        "category": "Dabbler",
        "icon": "$(edit)"
      },
      {
        "command": "dabblerSolution.setPrimaryReviewerModel",
        "title": "Set the Primary Reviewer's Model",
        "category": "Dabbler",
        "icon": "$(edit)"
      },
      {
        "command": "dabblerSolution.setAuxiliaryReviewerModel",
        "title": "Set the Auxiliary Reviewer's Model",
        "category": "Dabbler",
        "icon": "$(edit)"
      },
      {
        "command": "dabblerSolution.setAsMyDefault",
        "title": "Keep as Machine Default",
        "category": "Dabbler",
        "icon": "$(person)"
      },
      {
        "command": "dabblerSolution.refreshRecord",
        "title": "Update the Catalog",
        "category": "Dabbler",
        "icon": "$(sync)"
      },
      {
        "command": "dabblerSolution.storeCredential",
        "title": "Store a Key on This Machine",
        "category": "Dabbler",
        "icon": "$(key)"
      },
      {
        "command": "dabblerSolution.revealRepository",
        "title": "Reveal in File Explorer",
        "category": "Dabbler",
        "icon": "$(file-directory)"
      },
      {
        "command": "dabblerSolution.openWorkspace",
        "title": "Open Solution Workspace",
        "category": "Dabbler",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "dabblerSolution.identifyRemote",
        "title": "Say Where This Repository Is (Remote)",
        "category": "Dabbler",
        "icon": "$(link)"
      },
      {
        "command": "dabblerSolution.locateRepository",
        "title": "Point at a Local Folder",
        "category": "Dabbler",
        "icon": "$(folder)"
      },
      {
        "command": "dabblerSolution.cloneRepository",
        "title": "Clone This Repository",
        "category": "Dabbler",
        "icon": "$(cloud-download)"
      },
      {
        "command": "dabblerSolution.createRepository",
        "title": "Create This Repository",
        "category": "Dabbler",
        "icon": "$(new-folder)"
      },
      {
        "command": "dabbler.showFrameworkTerminal",
        "title": "Show Framework Terminal",
        "category": "Dabbler"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dabblerWorkExplorer.activateRepository",
          "when": "false"
        },
        {
          "command": "dabblerSessionSets.stopSession",
          "when": "false"
        },
        {
          "command": "dabbler.consultWithAi",
          "when": "false"
        },
        {
          "command": "dabblerSolution.setEngine",
          "when": "false"
        },
        {
          "command": "dabblerSolution.setReviewerTransport",
          "when": "false"
        },
        {
          "command": "dabblerSolution.setAuthoringModel",
          "when": "false"
        },
        {
          "command": "dabblerSolution.setPrimaryReviewerModel",
          "when": "false"
        },
        {
          "command": "dabblerSolution.setAuxiliaryReviewerModel",
          "when": "false"
        },
        {
          "command": "dabblerSolution.setAsMyDefault",
          "when": "false"
        },
        {
          "command": "dabblerSolution.refreshRecord",
          "when": "false"
        },
        {
          "command": "dabblerSolution.storeCredential",
          "when": "false"
        },
        {
          "command": "dabblerWorkExplorer.activateSession",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "dabblerSessionSets.refresh",
          "when": "view == dabblerWorkExplorerTree",
          "group": "navigation@1"
        },
        {
          "command": "dabblerSolution.openWorkspace",
          "when": "view == dabblerSolutionTree",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "submenu": "dabblerWorkExplorer.openFile",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;dabblerRepository;/",
          "group": "1_open@1"
        },
        {
          "command": "dabblerSessionSets.startSession",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-startSession;/",
          "group": "6_session@601"
        },
        {
          "command": "dabblerSessionSets.startSessionWithDifferentModels",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-startSession;/",
          "group": "6_session@602"
        },
        {
          "command": "dabblerSessionSets.closeSession",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-closeSession;/",
          "group": "6_session@602"
        },
        {
          "command": "dabblerSessionSets.stopSession",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-stopSession;/",
          "group": "6_session@606"
        },
        {
          "command": "dabbler.consultWithAi",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-consultWithAi;/",
          "group": "6_session@605"
        },
        {
          "command": "dabblerSessionSets.cancel",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-cancel;/",
          "group": "9_lifecycle@901"
        },
        {
          "command": "dabblerSessionSets.restore",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-restore;/",
          "group": "9_lifecycle@902"
        },
        {
          "command": "dabblerSolution.setEngine",
          "when": "view == dabblerSolutionTree && viewItem =~ /^dabblerConfig(Vehicle|Participant);authoring$/",
          "group": "1_set@1"
        },
        {
          "command": "dabblerSolution.setAuthoringModel",
          "when": "view == dabblerSolutionTree && viewItem =~ /^dabblerConfig(Role|Participant);authoring$/",
          "group": "1_set@2"
        },
        {
          "command": "dabblerSolution.setReviewerTransport",
          "when": "view == dabblerSolutionTree && viewItem =~ /^dabblerConfig(Vehicle|Participant);reviewing$/",
          "group": "1_set@1"
        },
        {
          "command": "dabblerSolution.setPrimaryReviewerModel",
          "when": "view == dabblerSolutionTree && viewItem =~ /^dabblerConfig(Role;primaryReviewer|Participant;reviewing)$/",
          "group": "1_set@2"
        },
        {
          "command": "dabblerSolution.setAuxiliaryReviewerModel",
          "when": "view == dabblerSolutionTree && viewItem =~ /^dabblerConfig(Role;auxiliaryReviewer|Participant;reviewing)$/",
          "group": "1_set@3"
        },
        {
          "command": "dabblerSolution.setAsMyDefault",
          "when": "view == dabblerSolutionTree && viewItem =~ /^dabblerConfig(Vehicle;(authoring|reviewing)|Role;(authoring|primaryReviewer|auxiliaryReviewer))$/",
          "group": "2_mine@1"
        },
        {
          "command": "dabblerSolution.refreshRecord",
          "when": "view == dabblerSolutionTree && viewItem == dabblerConfiguration",
          "group": "1_set@1"
        },
        {
          "command": "dabblerSolution.storeCredential",
          "when": "view == dabblerSolutionTree && viewItem =~ /^dabblerConfigCredential;/",
          "group": "1_set@1"
        },
        {
          "command": "dabblerSolution.openRepository",
          "when": "view == dabblerSolutionTree && viewItem == dabblerExternalHere",
          "group": "1_open@1"
        },
        {
          "command": "dabblerSolution.openRepositoryInNewWindow",
          "when": "view == dabblerSolutionTree && viewItem == dabblerExternalHere",
          "group": "1_open@2"
        },
        {
          "command": "dabblerSolution.revealRepository",
          "when": "view == dabblerSolutionTree && viewItem == dabblerExternalHere",
          "group": "1_open@3"
        },
        {
          "command": "dabblerSolution.cloneRepository",
          "when": "view == dabblerSolutionTree && viewItem == dabblerExternalRemote",
          "group": "2_place@1"
        },
        {
          "command": "dabblerSolution.locateRepository",
          "when": "view == dabblerSolutionTree && viewItem =~ /^dabblerExternal(Remote|Unknown)$/",
          "group": "2_place@2"
        },
        {
          "command": "dabblerSolution.identifyRemote",
          "when": "view == dabblerSolutionTree && viewItem == dabblerExternalUnknown",
          "group": "2_place@3"
        },
        {
          "command": "dabblerSolution.createRepository",
          "when": "view == dabblerSolutionTree && viewItem == dabblerExternalUnknown",
          "group": "2_place@4"
        }
      ],
      "dabblerWorkExplorer.openFile": [
        {
          "command": "dabblerSessionSets.openSpec",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-openSpec;/",
          "group": "1@101"
        },
        {
          "command": "dabblerSessionSets.openActivityLog",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-openActivityLog;/",
          "group": "1@102"
        },
        {
          "command": "dabblerSessionSets.openChangeLog",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-openChangeLog;/",
          "group": "1@103"
        },
        {
          "command": "dabblerSessionSets.openSessionState",
          "when": "view == dabblerWorkExplorerTree && viewItem =~ /;act-openSessionState;/",
          "group": "1@104"
        }
      ],
      "file/newFile": [
        {
          "command": "dabbler.setupNewProject",
          "group": "file"
        }
      ]
    },
    "submenus": [
      {
        "id": "dabblerWorkExplorer.openFile",
        "label": "Open File"
      }
    ],
    "walkthroughs": [
      {
        "id": "dabblerGetStarted",
        "title": "Set up an AI-led project",
        "description": "Prepare a repository for the Dabbler session workflow. Nothing is installed, and you are not asked to run any commands.",
        "steps": [
          {
            "id": "setUp",
            "title": "Set the project up",
            "description": "Writes the guidance files, the ignore rule for the router's machine state, the project's own declaration and the first two sessions -- then commits them, because session 1 is refused while they sit uncommitted.\n[Set Up New Project](command:dabbler.setupNewProject)",
            "media": {
              "markdown": "media/walkthrough-setup.md"
            },
            "completionEvents": [
              "onCommand:dabbler.setupNewProject"
            ]
          },
          {
            "id": "startSession",
            "title": "Start session 1",
            "description": "Session 1 authors the solution plan (one module is a fine answer); session 2 challenges the cuts and breaks the plan into numbered sessions. Session 1 asks you what the solution is -- the plan's substance is yours, and it does not guess it.\n[Open the Work Explorer](command:workbench.view.extension.dabblerSessionSetsContainer)",
            "media": {
              "markdown": "media/walkthrough-session.md"
            }
          }
        ]
      }
    ],
    "viewsWelcome": [
      {
        "view": "dabblerSolutionTree",
        "contents": "This shows what the project is being built FROM: its projects, what each one references, and who breaks when one of them changes.\n\nIt fills in once the repository is set up, from the solution's build files as the sessions write them.\n[Set Up New Project](command:dabbler.setupNewProject)",
        "when": "true"
      },
      {
        "view": "dabblerWorkExplorerTree",
        "contents": "This shows the work: which session is running, which step it is on, and anything waiting on you.\n\nNothing has run here yet.\n[Set Up New Project](command:dabbler.setupNewProject)",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "Dabbler AI Orchestration",
      "properties": {
        "dabbler.refreshSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "markdownDescription": "How often the Work Explorer re-reads a repository whose files have not changed. File watchers do most of the work; this is the backstop for changes they miss."
        },
        "dabbler.stalledAfterSeconds": {
          "type": "number",
          "default": 1800,
          "minimum": 60,
          "markdownDescription": "How long an in-flight session's record may sit still before the Work Explorer says nothing has been written for a while. It is a heartbeat, not a judgment: it reports that the record stopped moving, never that the work stopped being useful. Verification rounds routinely take ten minutes, so a short threshold calls every ordinary round a stall — and a signal that cries wolf is one people stop reading.\n\nThis wins over `verification.stalled_after_seconds` in the repository's `dabbler.yaml`, which wins over the built-in default."
        },
        "dabbler.terminalLocation": {
          "type": "string",
          "enum": [
            "editor",
            "panel"
          ],
          "enumDescriptions": [
            "Open the AI CLI and the Dabbler terminal side by side as editor tabs. They get the full height of the window, which is what a transcript and a job log both want.",
            "Open the Dabbler terminal split beside the AI CLI in the bottom panel, leaving the editor area to files."
          ],
          "default": "editor",
          "markdownDescription": "Where **Start Session** puts the AI CLI and the Dabbler terminal. A terminal cannot be moved after it is created, so this decides where each one opens; terminals already open keep the location they were opened at."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test:unit": "mocha 'src/test/suite/**/*.test.ts'",
    "test:playwright": "npm run compile && npx tsc --noEmit && npx playwright test",
    "package": "npm run compile && npx vsce package --no-dependencies",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.9",
    "dabbler-ai-router": "3.19.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "mocha": "^10.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "yaml": "^2.7.0"
  }
}
