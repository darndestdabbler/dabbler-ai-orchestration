{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "router-config.yaml",
  "type": "object",
  "required": [
    "providers",
    "models",
    "escalation"
  ],
  "properties": {
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "api_key_env",
          "rate_limit",
          "timeout_seconds",
          "retry"
        ],
        "properties": {
          "api_key_env": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "display_label": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "api_version": {
            "type": "string"
          },
          "timeout_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rate_limit": {
            "type": "object",
            "required": [
              "requests_per_minute",
              "tokens_per_minute"
            ],
            "properties": {
              "requests_per_minute": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "tokens_per_minute": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            }
          },
          "retry": {
            "type": "object",
            "required": [
              "max_retries",
              "backoff_base_seconds"
            ],
            "properties": {
              "max_retries": {
                "type": "integer",
                "minimum": 0
              },
              "backoff_base_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "provider"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "is_enabled": {
            "type": "boolean"
          },
          "is_enabled_as_verifier": {
            "type": "boolean"
          },
          "max_context_tokens": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "max_output_tokens": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "system_prompt_file": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "generation_params": {
            "type": "object"
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "description": "Selection by role, applied identically on both transports. A role declares the provider set it may draw from (a hard filter) and a preference order (ordering only -- a model the order does not name still qualifies and simply sorts after the named ones). Names in 'prefer' are model ids as each transport puts them on the wire, so a name that matches nothing on this path is inert rather than an error.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prefer": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "require_provider_in": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "required": [
        "enabled",
        "max_escalations",
        "triggers"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_escalations": {
          "type": "integer",
          "minimum": 0
        },
        "triggers": {
          "type": "object"
        },
        "refusal_phrases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "properties": {
        "profile": {
          "enum": [
            "api",
            "copilot-cli",
            "offline"
          ]
        }
      }
    },
    "transports": {
      "type": "object",
      "properties": {
        "offline": {
          "type": "object",
          "properties": {
            "responses_dir": {
              "type": "string",
              "minLength": 1,
              "description": "Directory of scripted verifier responses, consumed in lexical order. Overridden by DABBLER_OFFLINE_RESPONSES."
            }
          }
        },
        "copilot-cli": {
          "type": "object",
          "properties": {
            "binary": {
              "type": "string",
              "minLength": 1
            },
            "lockfile": {
              "type": "string",
              "minLength": 1
            },
            "billed_usage_unavailable": {
              "type": "boolean"
            },
            "max_invocations_per_session": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "timeouts": {
              "type": "object",
              "properties": {
                "spawn_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "first_byte_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "total_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    },
    "task_type_params": {
      "type": "object"
    },
    "testing": {
      "type": "object",
      "description": "Suites, deterministic controls, and the path-to-test selection rules. A repository declares this in its own tracked dabbler.yaml; the block appears here because that file is deep-merged onto this one and the merged result is validated as a whole."
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "description": "Path facts about the repository, declared in its tracked dabbler.yaml. Deliberately not part of run_policy: the machine-local overlay may override run policy and may not override this.",
      "properties": {
        "sensitive_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "packaging": {
      "type": "object",
      "description": "Step (f) of the session lifecycle: pack, then push to the feed. A repository that declares no packaging block publishes nothing, which is a declaration rather than an omission -- there is no inferred build here, because guessing how a repository publishes is guessing an ecosystem. Placeholders are substituted per argv element and never through a shell: {output} is the run's own output directory, {artifact} is one file pack produced, {feed} is the declared feed, and {secret} is the resolved credential. Both commands are argv, not shell strings, so a credential cannot be re-split by a shell, and both are spawned with the child-environment allowlist, so the credential is in no environment at all.",
      "additionalProperties": false,
      "required": [
        "pack",
        "push"
      ],
      "properties": {
        "pack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "argv"
          ],
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Must contain {output}. A pack that does not take its output directory from the framework writes into the repository, dirtying the tree that was just verified and leaving last week's build sitting where this week's push will find it."
            },
            "cwd": {
              "type": "string"
            },
            "timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "push": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "argv",
            "feed",
            "secret"
          ],
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Must contain {artifact}, {feed} and {secret}. All three are required rather than conventional: a command without {artifact} pushes nothing the framework can name, a command without {feed} makes the recorded destination a label instead of a fact about what ran, and a command without {secret} is publishing on an ambient credential the framework cannot see -- which makes 'the PAT is never in an environment' unprovable rather than true."
            },
            "feed": {
              "type": "string",
              "minLength": 1
            },
            "secret": {
              "type": "string",
              "minLength": 1,
              "description": "The NAME of the credential, never its value. It resolves through ai_router.secret_resolver at spawn time, exactly as a provider's api_key_env does."
            },
            "secret_source": {
              "type": "string",
              "minLength": 1,
              "description": "Which secret_resolver backend holds it. Defaults to 'env'."
            },
            "cwd": {
              "type": "string"
            },
            "timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "verification": {
      "type": "object"
    },
    "critique": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pipeline": {
          "enum": [
            "off",
            "shadow",
            "enforce"
          ],
          "description": "The critique pipeline's authority. 'off' is the default and writes nothing. 'shadow' records critique artifacts without letting them decide anything. 'enforce' is declared here so the vocabulary lives in one place, and is refused at load until the set that implements it lands — see config.py, which names that set in the refusal."
        }
      }
    },
    "metrics": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    },
    "run_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "fast",
            "verified"
          ]
        },
        "verification_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "diff_limit_lines": {
          "type": "integer",
          "minimum": 1
        },
        "check_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model_usd": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "model_dispatches": {
              "type": "integer",
              "minimum": 1
            },
            "elapsed_minutes": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "push_on_finish": {
          "type": "boolean"
        },
        "worktree_per_run": {
          "type": "boolean"
        },
        "remote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "explorer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stale_after_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key_set_id": {
          "type": "string",
          "minLength": 1
        },
        "record": {
          "type": "string",
          "minLength": 1
        },
        "max_age_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "seat_max_age_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "description": "How far `dabbler session drive` may go. Declared in the repository's dabbler.yaml (it is a repository-owned block) and read here after the merge.",
      "properties": {
        "max_invocations": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": [
            "string",
            "null"
          ]
        },
        "init": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "argv": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "windows",
                      "posix"
                    ],
                    "properties": {
                      "windows": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      },
                      "posix": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                ]
              },
              "probe_argv": {
                "oneOf": [
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "windows",
                      "posix"
                    ],
                    "properties": {
                      "windows": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      },
                      "posix": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                ]
              },
              "shell": {
                "type": "boolean"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "timeout_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  }
}
