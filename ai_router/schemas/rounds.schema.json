{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rounds.jsonl row (one verification round)",
  "description": "One row per completed verification round in .dabbler/runs/<set>/s<N>/rounds.jsonl. Written only by the CLI (ai_router.verify); the close gate reads it. A row that fails this schema on read is a refusal, never a skip. Two terminal row types may be written beside plain rounds: 'adjudication' (a third provider judged the recorded disputes) and 'remediated_at_cap' (every blocking finding of the last round was fixed and the cap left the fix unreviewed — the work lands labelled unreviewed, which is not a waiver: nothing was accepted over a standing finding). The retired 'waive' type stays readable because historical ledgers carry it; no writer emits it, and WAIVED is no longer in the writer's verdict vocabulary.",
  "type": "object",
  "required": [
    "round",
    "verdict",
    "blocking",
    "findings",
    "completion_tree",
    "recorded_at"
  ],
  "properties": {
    "round": { "type": "integer", "minimum": 1 },
    "phase": { "type": "string", "enum": ["full", "fix-delta"] },
    "verdict": {
      "type": "string",
      "enum": ["VERIFIED", "ISSUES_FOUND", "WAIVED", "REMEDIATED_AT_CAP"]
    },
    "blocking": { "type": "boolean" },
    "verifier_model": { "type": "string", "minLength": 1 },
    "verifier_provider": { "type": "string", "minLength": 1 },
    "orchestrator_provider": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "severity"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["critical", "major", "minor"]
          },
          "category": { "type": "string" },
          "failureScenario": { "type": "string" },
          "evidencePaths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "cost_usd": { "type": ["number", "null"] },
    "baseline_tree": { "type": ["string", "null"] },
    "completion_tree": { "type": "string", "minLength": 7 },
    "previous_tree": { "type": "string", "minLength": 7 },
    "recorded_at": { "type": "string", "minLength": 1 },
    "transport": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["adjudication", "waive", "remediated_at_cap"]
    },
    "excluded_providers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["finding_index", "outcome"],
        "properties": {
          "finding_index": { "type": "integer", "minimum": 0 },
          "outcome": { "type": "string", "enum": ["UPHELD", "OVERRULED"] },
          "reasons": { "type": "string" }
        }
      }
    },
    "attestation": { "type": "string", "minLength": 1 },
    "remediated": {
      "type": "object",
      "required": ["reviewed_round", "findings"],
      "properties": {
        "reviewed_round": { "type": "integer", "minimum": 1 },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["description", "severity"]
          }
        }
      }
    },
    "waived": {
      "type": "object",
      "required": ["exhausted_via", "findings"],
      "properties": {
        "exhausted_via": {
          "type": "string",
          "enum": ["upheld-adjudication", "adjudication-unavailable"]
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["description", "severity"]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "round": { "minimum": 2 } } },
      "then": { "required": ["previous_tree"] }
    },
    {
      "if": {
        "properties": { "type": { "const": "adjudication" } },
        "required": ["type"]
      },
      "then": { "required": ["outcomes", "excluded_providers"] }
    },
    {
      "if": {
        "properties": { "type": { "const": "waive" } },
        "required": ["type"]
      },
      "then": {
        "required": ["attestation", "waived"],
        "properties": {
          "verdict": { "const": "WAIVED" },
          "blocking": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "remediated_at_cap" } },
        "required": ["type"]
      },
      "then": {
        "required": ["remediated", "previous_tree"],
        "properties": {
          "verdict": { "const": "REMEDIATED_AT_CAP" },
          "blocking": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": { "enum": ["waive", "remediated_at_cap"] }
        },
        "required": ["type"]
      },
      "then": true,
      "else": {
        "required": ["verifier_model", "verifier_provider"],
        "properties": {
          "verdict": { "enum": ["VERIFIED", "ISSUES_FOUND"] }
        }
      }
    }
  ]
}
