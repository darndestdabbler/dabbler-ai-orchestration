{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rounds.jsonl row (one verification round)",
  "description": "One row per completed verification round in .dabbler/runs/<set>/s<N>/rounds.jsonl. Written only by the CLI (ai_router.verify); the close gate reads it. A row that fails this schema on read is a refusal, never a skip. Two terminal row types exist beside plain rounds: 'adjudication' (a third provider judged the recorded disputes) and 'waive' (the operator attested acceptance of UNVERIFIED work at an interactive prompt — WAIVED is not a verification).",
  "type": "object",
  "required": [
    "round",
    "verdict",
    "blocking",
    "findings",
    "completion_tree",
    "recorded_at"
  ],
  "properties": {
    "round": { "type": "integer", "minimum": 1 },
    "phase": { "type": "string", "enum": ["full", "fix-delta"] },
    "verdict": {
      "type": "string",
      "enum": ["VERIFIED", "ISSUES_FOUND", "WAIVED"]
    },
    "blocking": { "type": "boolean" },
    "verifier_model": { "type": "string", "minLength": 1 },
    "verifier_provider": { "type": "string", "minLength": 1 },
    "orchestrator_provider": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "severity"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["critical", "major", "minor"]
          },
          "category": { "type": "string" },
          "failureScenario": { "type": "string" },
          "evidencePaths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "cost_usd": { "type": ["number", "null"] },
    "baseline_tree": { "type": ["string", "null"] },
    "completion_tree": { "type": "string", "minLength": 7 },
    "previous_tree": { "type": "string", "minLength": 7 },
    "recorded_at": { "type": "string", "minLength": 1 },
    "transport": { "type": "string" },
    "type": { "type": "string", "enum": ["adjudication", "waive"] },
    "excluded_providers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["finding_index", "outcome"],
        "properties": {
          "finding_index": { "type": "integer", "minimum": 0 },
          "outcome": { "type": "string", "enum": ["UPHELD", "OVERRULED"] },
          "reasons": { "type": "string" }
        }
      }
    },
    "attestation": { "type": "string", "minLength": 1 },
    "waived": {
      "type": "object",
      "required": ["exhausted_via", "findings"],
      "properties": {
        "exhausted_via": {
          "type": "string",
          "enum": ["upheld-adjudication", "adjudication-unavailable"]
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["description", "severity"]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "round": { "minimum": 2 } } },
      "then": { "required": ["previous_tree"] }
    },
    {
      "if": {
        "properties": { "type": { "const": "adjudication" } },
        "required": ["type"]
      },
      "then": { "required": ["outcomes", "excluded_providers"] }
    },
    {
      "if": {
        "properties": { "type": { "const": "waive" } },
        "required": ["type"]
      },
      "then": {
        "required": ["attestation", "waived"],
        "properties": {
          "verdict": { "const": "WAIVED" },
          "blocking": { "const": false }
        }
      },
      "else": {
        "required": ["verifier_model", "verifier_provider"],
        "properties": {
          "verdict": { "enum": ["VERIFIED", "ISSUES_FOUND"] }
        }
      }
    }
  ]
}
