        "category": "Dabbler"
      },
      {
        "command": "dabbler.openPrForSet",
        "title": "Open PR for this set",
        "category": "Dabbler"
      },
      {
        "command": "dabbler.finalizeMergedSet",
        "title": "Finalize merged set",
        "category": "Dabbler"
      },
      {
        "command": "dabbler.cutReleaseTag",
        "title": "Cut release tag",
        "category": "Dabbler"
      },
      {
        "command": "dabbler.startHotfixFromTag",
        "title": "Start hotfix from tag",
        "category": "Dabbler"
      },
      {
        "command": "dabbler.rollBackToTag",
